    <!-- Logic -->
    <script>
        // Navbar Scroll Effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('bg-black/90', 'shadow-lg');
                nav.classList.remove('glass-panel');
            } else {
                nav.classList.add('glass-panel');
                nav.classList.remove('bg-black/90', 'shadow-lg');
            }
        });

        // WhatsApp Form Handler
        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const name = document.getElementById('name').value;
            const date = document.getElementById('date').value;
            const time = document.getElementById('time').value;
            const guests = document.getElementById('guests').value;
            
            if(!name || !date || !time) {
                alert('Please fill in all details.');
                return;
            }

            const text = `Hello Urban Bites! I would like to reserve a table.%0A%0AName: ${name}%0ADate: ${date}%0ATime: ${time}%0AGuests: ${guests}`;
            
            window.open(`https://wa.me/916360283820?text=${text}`, '_blank');
        });

        // Set min date to today
        document.getElementById('date').min = new Date().toISOString().split("T")[0];
    </script>
