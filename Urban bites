    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        glass: "rgba(0, 0, 0, 0.6)",
                        glassBorder: "rgba(250, 204, 21, 0.2)",
                        glassHighlight: "rgba(250, 204, 21, 0.1)",
                        primary: "#FACC15", /* Bright Yellow/Gold */
                        primaryDark: "#CA8A04", /* Darker Gold */
                        secondary: "#18181b", /* Zinc 900 */
                        accent: "#FFFFFF" /* White */
                    },
                    fontFamily: {
                        sans: ['Montserrat', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'spin-slow': 'spin 12s linear infinite',
                        'shimmer': 'shimmer 2s linear infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' },
                        },
                        shimmer: {
                            '0%': { backgroundPosition: '-1000px 0' },
                            '100%': { backgroundPosition: '1000px 0' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Base Glassmorphism Engine - Yellow/Black Theme */
        body {
            background-color: #050505;
            background-image: 
                radial-gradient(at 0% 0%, rgba(250, 204, 21, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(202, 138, 4, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(50, 50, 50, 0.3) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(0, 0, 0, 1) 0px, transparent 50%);
            background-attachment: fixed;
            color: #ffffff;
            overflow-x: hidden;
        }

        .glass-panel {
            background: rgba(10, 10, 10, 0.7);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(250, 204, 21, 0.15); /* Yellow tinted border */
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(30, 30, 30, 0.6) 0%, rgba(10, 10, 10, 0.8) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-5px) scale(1.02);
            background: linear-gradient(135deg, rgba(250, 204, 21, 0.1) 0%, rgba(0, 0, 0, 0.9) 100%);
            border-color: rgba(250, 204, 21, 0.4);
            box-shadow: 0 15px 40px rgba(0,0,0,0.6), 
                        0 0 20px rgba(250, 204, 21, 0.2); /* Gold glow on hover */
        }

        /* Text Glows */
        .text-glow {
            text-shadow: 0 0 10px rgba(250, 204, 21, 0.3), 0 0 20px rgba(250, 204, 21, 0.1);
        }
        
        .neon-border {
            position: relative;
        }
        .neon-border::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0%;
            height: 2px;
            background: #FACC15;
            transition: width 0.3s ease;
            box-shadow: 0 0 10px #FACC15;
        }
        .neon-border:hover::after {
            width: 100%;
        }

        /* Loading Shimmer Effect */
        .loading-shimmer {
            background: linear-gradient(to right, rgba(255,255,255,0.05) 8%, rgba(250, 204, 21, 0.15) 18%, rgba(255,255,255,0.05) 33%);
            background-size: 1000px 100%;
            animation: shimmer 1.5s infinite linear;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #000000; 
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(250, 204, 21, 0.3); 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(250, 204, 21, 0.6); 
        }

        /* Floating Orbs for Depth */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: -1;
            opacity: 0.4;
        }
        
        /* Smooth selection */
        ::selection {
            background: #FACC15;
            color: #000000;
        }

        /* Markdown Styles for AI Output */
        .prose-custom strong { color: #FACC15; font-weight: 700; }
        .prose-custom ul { list-style-type: disc; padding-left: 1.5em; margin-top: 0.5em; margin-bottom: 0.5em; }
        .prose-custom li { margin-bottom: 0.25em; color: #e5e7eb; }
        .prose-custom p { margin-bottom: 0.75em; }
    </style>
</head>
